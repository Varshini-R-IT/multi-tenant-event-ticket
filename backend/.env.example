# ============================================================
# Multi-Tenant Event & Ticket Reservation System
# Backend Environment Variables
# ============================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret — change to a long random string in production
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Database (Optional)
# Leave blank to use SQLite (sql.js WASM) — zero config, works everywhere
# Set to a PostgreSQL connection string to use PostgreSQL instead:
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL=

# Redis Cache (Optional)
# Leave blank to use the built-in in-memory distributed lock engine
# Set to a Redis connection string (e.g., from Upstash) for external Redis:
# REDIS_URL=redis://default:password@host:6379
REDIS_URL=
