{
  "info": {
    "_postman_id": "a9b7c123-e456-4789-bf01-89abdef12345",
    "name": "Multi-Tenant Event & Ticket Reservation System API",
    "description": "Comprehensive test suite for the Multi-Tenant Event & Tiered Ticket Reservation Engine.\n\nCovers:\n1. Role-Based Access Control (Admin, Organizer, Attendee)\n2. Event Management with Tiers & Sales Cut-Off Dates\n3. Redis Caching Verification (X-Cache header HIT/MISS)\n4. 10-Minute Temporary Hold Reservation Engine\n5. Race Condition & Concurrency Edge Cases (409 Conflict)\n6. Mock Payment Gateway Simulation (Instant Approval, Card Decline, Async Webhook)\n7. Order & QR Code Digital Ticket Generation\n8. Multi-Tenant Revenue & Conversion Funnel Analytics\n9. Background Worker Expired Hold Cleanup",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "organizerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "attendeeToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "activeEventId",
      "value": "evt_ai_cloud_2026",
      "type": "string"
    },
    {
      "key": "activeTierId",
      "value": "tier_ai_ga",
      "type": "string"
    },
    {
      "key": "reservationId",
      "value": "",
